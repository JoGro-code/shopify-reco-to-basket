{%- if recommendations.performed? -%}
  <ul data-cross-sell-results="{{ section.id | escape }}">
    {%- for recommended_product in recommendations.products -%}
      <li class="grid__item" data-cross-sell-product="{{ recommended_product.id }}">
        {% render 'card-product',
          card_product: recommended_product,
          media_aspect_ratio: section.settings.image_ratio,
          image_shape: section.settings.image_shape,
          show_secondary_image: section.settings.show_secondary_image,
          show_vendor: section.settings.show_vendor,
          show_rating: section.settings.show_rating,
          section_id: section.id
        %}
      </li>
    {%- endfor -%}
  </ul>
{%- else -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="related-products page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-cross-sell-section="{{ section.id | escape }}"
    data-cart-url="{{ routes.cart_url | append: '.js' | escape }}"
    data-recommendations-url="{{ routes.product_recommendations_url | escape }}"
  >
    <h2 class="related-products__heading inline-richtext {{ section.settings.heading_size }}">
      Passende Produkte zu deinem Warenkorb
    </h2>
    <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down" role="list" data-cross-sell-list hidden></ul>
  </div>
  {% if section.settings.image_shape == 'arch' %}
    {% render 'mask-arch' %}
  {% endif %}
</div>
<script src="{{ 'cross-sell.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.cart-cross-sell.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.cart-cross-sell.settings.paragraph__1.content"
    },
    {
      "type": "header",
      "content": "Größenersatz / Size alternatives",
      "info": "[Check a shoe size chart for free](https://recently-viewed-products.fly.dev/shopify-footwear-fit-check?locale=en&ref=github-dawn-cart#foot-length-audit). Preview two sizes. Showing the comparison to shoppers uses RVI Basic.\n\n[RVI-Warenkorbbeispiel ausprobieren](https://recently-viewed-products.fly.dev/cart-recovery-tutorial?locale=de&ref=github-dawn-cart#abc-cart) · [Try the RVI cart example](https://recently-viewed-products.fly.dev/cart-recovery-tutorial?locale=en&ref=github-dawn-cart#abc-cart)\n\n[Zusatzangebot im Entwurf testen](https://recently-viewed-products.fly.dev/go/shopify/de-dawn-editor-cart-offer) · [Preview a cart add-on](https://recently-viewed-products.fly.dev/go/shopify/en-dawn-editor-cart-offer)\n\n[Deckungsbeitrag nach Bundle-Teilretouren schätzen](https://recently-viewed-products.fly.dev/shopify-variant-audit?locale=de&ref=bundle-return-dawn#fixed-bundle-partial-return) · [Estimate contribution after partial bundle returns](https://recently-viewed-products.fly.dev/shopify-variant-audit?locale=en&ref=bundle-return-dawn#fixed-bundle-partial-return)"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Passende Produkte zu deinem Warenkorb",
      "label": "t:sections.cart-cross-sell.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "t:sections.cart-cross-sell.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.cart-cross-sell.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.cart-cross-sell.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.cart-cross-sell.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.cart-cross-sell.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.cart-cross-sell.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.cart-cross-sell.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label",
      "info": "t:sections.all.image_shape.info"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.cart-cross-sell.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.cart-cross-sell.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.cart-cross-sell.settings.show_rating.label",
      "info": "t:sections.cart-cross-sell.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.cart-cross-sell.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.cart-cross-sell.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.cart-cross-sell.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.cart-cross-sell.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
